<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COVID-19 Conditional Visualization</title>
    <style>
        body { margin: 0; font-family: Arial, sans-serif; }
        .report-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
        .notice {
            background: #f0f2f5;
            padding: 10px;
            text-align: center;
            font-size: 14px;
            border-bottom: 1px solid #ccc;
        }
        a {
            color: #0066cc;
        }
    </style>
</head>
<body>
<div class="notice">
    ⚠️ This report requires IBM Cognos authentication. If you see a login page, please sign in with your credentials.
    <a href="https://ap2.ca.analytics.ibm.com/bi/?pathRef=.my_folders%2Fconditional%2Bvisualization%2Bwith%2Bcovid%2Bdata&action=run&format=HTML&prompt=false&nav_filter=true" target="_blank">Open in full tab</a>
</div>
<div class="report-container">
    <iframe 
        src="https://ap2.ca.analytics.ibm.com/bi/?pathRef=.my_folders%2Fconditional%2Bvisualization%2Bwith%2Bcovid%2Bdata&action=run&format=HTML&prompt=false&nav_filter=true"
        title="IBM Cognos COVID Report"
        allow="fullscreen"
    ></iframe>
</div>
</body>
</html>
